<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include business settings and preferences -->
    <include domain="sharedpref" path="."/>
    <include domain="database" path="business_data.db"/>
    
    <!-- Exclude sensitive authentication data -->
    <exclude domain="sharedpref" path="auth_tokens.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    <exclude domain="sharedpref" path="CognitoIdentityProviderCache.xml"/>
    <exclude domain="sharedpref" path="com.amazonaws.android.auth.xml"/>
    <exclude domain="sharedpref" path="com.amplify.awsCognitoAuthPlugin.xml"/>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <exclude domain="sharedpref" path="api_keys.xml"/>
</full-backup-content>
